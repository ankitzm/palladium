{
  "name": "palladium",
  "private": true,
  "scripts": {
    "dev:server": "pnpm --filter @palladium/server dev",
    "dev:web": "pnpm --filter @palladium/web dev",
    "dev": "pnpm run --parallel dev:server dev:web",
    "build": "pnpm --filter @palladium/shared build && pnpm run --parallel build:server build:web",
    "build:server": "pnpm --filter @palladium/server build",
    "build:web": "pnpm --filter @palladium/web build",
    "db:push": "pnpm --filter @palladium/shared db:push",
    "db:generate": "pnpm --filter @palladium/shared db:generate",
    "db:studio": "pnpm --filter @palladium/shared db:studio",
    "seed": "pnpm --filter @palladium/server seed"
  }
}
